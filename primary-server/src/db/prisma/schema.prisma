// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Students {
  id                 String   @id @default(uuid()) 
  email              String   @unique
  firstName          String  
  middleName          String  
  lastName           String 
  mobileNumber       String   @unique     
  password           String
  walletAddress      String   @unique
  isVerified         Boolean  @default(false)
  refreshToken       String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@map("Students") 
  studentProfile     StudentProfile[]
  studentDoc         StudentDocument[]
  
}

model Professors {
  id                 String   @id @default(uuid())
  email              String   @unique
  firstName          String
  lastName           String
  mobileNumber       String   @unique 
  password           String
  walletAddress      String   @unique
  isVerified         Boolean  @default(false)
  refreshToken       String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@map("Professors") 
  professorProfile   ProfessorProfile[]
  professorDoc        ProfessorDocument[]
  
}

 

model StudentProfile{
  id                String @id @default(uuid())
  universityName    String
  collegeName       String
  majorName         String
  currentSem        String
  startYear         String
  gradYear          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  //relation
  studentID         String  @unique
  student           Students @relation(fields: [studentID], references: [id])
  
}

enum EmploymentType {
  full_time
  visiting
  contract
}
model ProfessorProfile{
  id                String @id @default(uuid())
  universityName    String
  collegeName       String
  department        String
  designation       String
  employmentType    EmploymentType  @default(full_time)
  joiningYear       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  //relation
  professorID       String  @unique
  professor         Professors @relation(fields: [professorID], references: [id])
  
}

model StudentDocument {
  id          String   @id @default(uuid())
  studentId   String
  student     Students @relation(fields: [studentId], references: [id])
  docType     StudentDocType
  url         String
  status      VerificationStatus @default(pending)
  rejectionReason   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum StudentDocType {
  id_card
  fee_receipt
}

model ProfessorDocument {
  id           String   @id @default(uuid())
  professorId  String
  professor    Professors @relation(fields: [professorId], references: [id])
  docType      ProfessorDocType
  url          String
  status       VerificationStatus @default(pending)
  rejectionReason   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ProfessorDocType {
  id_card
  employment_letter
}

enum VerificationStatus {
  pending
  approved
  rejected
}
